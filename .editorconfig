root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{ps1,bat,cmd}]
end_of_line = crlf

[*.{yml,yaml,json,md,html,css,js,mjs}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[{*.go,go.mod}]
indent_style = tab

[third_party/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
