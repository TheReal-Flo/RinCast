#include <windows.h>
#include <ntverp.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DRV
 FILESUBTYPE VFT2_DRV_SOUND
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "RinCast"
            VALUE "FileDescription", "RinCast Virtual Audio Driver"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "rincastaudio.sys"
            VALUE "OriginalFilename", "rincastaudio.sys"
            VALUE "ProductName", "RinCast"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
